# Dependencies
node_modules/
jspm_packages/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment / secrets
.env
.env.*
!.env.example

# Test / coverage output
coverage/
*.lcov
.nyc_output/

# Build / cache output
dist/
build/
.build/
.cache/
*.tsbuildinfo

# Static-site staging (generated inlined data twin). docs/ is the Pages OUTPUT —
# commit it for branch-based Pages, or uncomment `docs/` to let Actions own it.
# docs/

# Sourcebook prose overlay (ST-1 / decision D-N): verbatim GW rulebook text,
# generated by `npm run sync:chargen`. This repo is PUBLIC — it must NEVER be
# committed. GET /api/prose degrades to { available:false } without it.
api/data/chargen/prose.local.mjs
api/data/chargen/*.local.mjs

# Runtime
pids/
*.pid
*.seed

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Local tool config (keep shared .claude settings tracked)
.claude/settings.local.json

# D9 privacy safeguard (2026-09-08): player-identifying data never commits.
# The importer's roster map + player-name patterns live in the local config;
# the privacy scanner's doubt log is per-machine review state.
tools/*.local.mjs
_privacy_review.local.json
