{
  "name": "dh2-roll-api",
  "version": "1.0.0",
  "description": "Minimalist Dark Heresy 2e roll/test API with HTML front-end",
  "type": "module",
  "main": "api/server.mjs",
  "scripts": {
    "start": "node api/server.mjs",
    "test": "node --test \"api/test/**/*.test.mjs\"",
    "build:static": "node scripts/build-static.mjs",
    "import:campaign": "node tools/import-campaign.mjs",
    "serve:static": "node scripts/serve-static.mjs",
    "schema:json": "node tools/generate-json-schema.mjs",
    "sync:chargen": "node tools/sync-chargen.mjs",
    "build:engine-lib": "node scripts/build-engine-lib.mjs",
    "merge:characters": "node tools/merge-characters.mjs --roll20=../roll20_bridge/cache/dh2_campaign/characters/roll20_characters_2026-07-23.json --xlsx-roster --out=campaign/characters --report",
    "test:coverage": "node --test --experimental-test-coverage \"api/test/**/*.test.mjs\""
  },
  "dependencies": {
    "express": "^4.19.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "xlsx": "^0.18.5"
  }
}
